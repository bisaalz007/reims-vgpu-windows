# display_release_with_page: Hot unplug with a page connected, and a fresh display on the same port: release detaches the client (8, mode count 0), and the new display reconnects (4) from state 0. The serial of the released display can be used again.
{"displays": [{"modes": [[64, 32, 60]], "name": "suite", "port": 0, "serial": 40}], "op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_gpa": "0x40008000", "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x101c", "op": "mmio_w", "val": "0x10001"}
{"off": "0x1030", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1004", "op": "mmio_w", "val": "0x8000"}
{"off": "0x1010", "op": "mmio_w", "val": "0x400"}
{"off": "0x1000", "op": "mmio_w", "val": "0x1"}
{"gpa": "0x40010104", "hex": "0f000000", "op": "mem"}
{"gpa": "0x40008400", "hex": "0100000014000000010000000000000004000100", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0x14"}
{"ge": "0x1", "gpa": "0x40008000", "label": "stamp 1 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x40008414", "hex": "0200000014000000020000000000000001000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0x28"}
{"ge": "0x2", "gpa": "0x40008000", "label": "stamp 2 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"label": "connected", "op": "events"}
{"display": 0, "name": "release_display", "op": "api"}
{"irqs": 4, "op": "wait", "timeout_ms": 5000}
{"label": "released", "op": "events", "order": true}
{"gpa": "0x40010000", "label": "released", "len": "0x4000", "op": "diff"}
{"display": 0, "name": "display_props", "op": "api"}
{"name": "new_display", "op": "api", "spec": {"modes": [[32, 16, 60]], "name": "again", "port": 0, "serial": 40}}
{"irqs": 5, "op": "wait", "timeout_ms": 5000}
{"label": "replugged", "op": "events", "order": true}
{"gpa": "0x40010000", "label": "replugged", "len": "0x4000", "op": "diff"}
{"gpa": "0x40008428", "hex": "0200000014000000030000000000000002000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0x3c"}
{"ge": "0x3", "gpa": "0x40008000", "label": "stamp 3 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x4000843c", "hex": "0100000014000000040000000000000000000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0x50"}
{"ge": "0x4", "gpa": "0x40008000", "label": "stamp 4 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"label": "disconnected", "op": "events", "order": true}
{"gpa": "0x40010000", "label": "disconnected", "len": "0x4000", "op": "diff"}
{"display": 1, "name": "release_display", "op": "api"}
{"op": "quiesce", "quiet_ms": 40}
{"label": "released with no page", "op": "events"}
