# suspend_pause: pause quiesces and drains the FIFOs, pauses the guest displays and suppresses interrupts: stamps still land in guest memory and set 0x1018 bits, but raise nothing; unpause restarts the FIFOs and raises exactly one interrupt. A display page while paused: mode lists do not run the machine until unpause.
{"displays": [{"modes": [[64, 32, 60]], "name": "suite", "port": 0, "serial": 1000}], "op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_gpa": "0x40008000", "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x101c", "op": "mmio_w", "val": "0x10001"}
