# iosfc_map_test_unmap_v2: Map, test and unmap one BGRA surface over one guest page, v1 and v2: map sets the descriptor's mapped bit (bit 1) and writes status 0; test writes i x 8 into each 8-byte word of the surface, into the guest page; unmap clears the bit. A second map of a mapped id succeeds without re-creating it; unmapping an unmapped id succeeds; testing it fails (BadArgument). One interrupt a command.
{"iosfc": true, "op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1030", "op": "iosfc_w", "val": "0x1"}
{"off": "0x1010", "op": "iosfc_w", "val": "0x4000c000"}
{"off": "0x1000", "op": "iosfc_w", "val": "0x40008000"}
{"off": "0x1008", "op": "iosfc_w", "val": "0x400"}
{"gpa": "0x40010000", "hex": "15000400", "op": "mem"}
{"gpa": "0x4000c000", "hex": "19000400", "op": "mem"}
{"gpa": "0x40018400", "hex": "", "op": "mem"}
{"gpa": "0x40008000", "hex": "0100000001000000efbead7e00000000", "op": "mem"}
{"off": "0x1018", "op": "iosfc_w", "val": "0x1"}
{"iosfc_irqs": 1, "label": "iosfc irqs 1", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x40008000", "label": "map", "len": "0x10", "op": "dump"}
{"gpa": "0x40018400", "label": "descriptor after map", "len": "0x8", "op": "dump"}
{"gpa": "0x40008010", "hex": "0300000001000000efbead7e00000000", "op": "mem"}
{"off": "0x1018", "op": "iosfc_w", "val": "0x2"}
{"iosfc_irqs": 2, "label": "iosfc irqs 2", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x40008010", "label": "test", "len": "0x10", "op": "dump"}
{"gpa": "0x40014000", "label": "after test", "len": "0x4000", "op": "diff"}
{"gpa": "0x40008020", "hex": "0100000001000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008030", "hex": "0200000001000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008040", "hex": "0200000001000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008050", "hex": "0300000001000000efbead7e00000000", "op": "mem"}
{"off": "0x1018", "op": "iosfc_w", "val": "0x6"}
{"iosfc_irqs": 6, "label": "iosfc irqs 6", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x40008020", "label": "map again, unmap twice, test", "len": "0x10", "op": "dump"}
{"gpa": "0x40008030", "label": "map again, unmap twice, test", "len": "0x10", "op": "dump"}
{"gpa": "0x40008040", "label": "map again, unmap twice, test", "len": "0x10", "op": "dump"}
{"gpa": "0x40008050", "label": "map again, unmap twice, test", "len": "0x10", "op": "dump"}
{"gpa": "0x40018400", "label": "descriptor after unmap", "len": "0x8", "op": "dump"}
{"label": "interrupts", "op": "events"}
{"label": "end", "off": "0x1000", "op": "iosfc_r"}
{"label": "end", "off": "0x1008", "op": "iosfc_r"}
{"label": "end", "off": "0x1010", "op": "iosfc_r"}
{"label": "end", "off": "0x1018", "op": "iosfc_r"}
{"label": "end", "off": "0x1020", "op": "iosfc_r"}
{"label": "end", "off": "0x1028", "op": "iosfc_r"}
{"label": "end", "off": "0x1030", "op": "iosfc_r"}
