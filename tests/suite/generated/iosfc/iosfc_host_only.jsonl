# iosfc_host_only: Host-only surfaces (v2 bit 1 of +0x41) need no page table and never touch guest memory: test writes the host's copy. Their total, in whole pages, is capped at 1 GiB: one page, 512 MiB and 512 MiB less two pages fit, a fourth one-page surface reaches exactly 1 GiB and fits (the check is >), a fifth does not (NoMemory); unmap gives the budget back.
{"iosfc": true, "op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1030", "op": "iosfc_w", "val": "0x1"}
{"off": "0x1010", "op": "iosfc_w", "val": "0x4000c000"}
{"off": "0x1000", "op": "iosfc_w", "val": "0x40008000"}
{"off": "0x1008", "op": "iosfc_w", "val": "0x400"}
{"gpa": "0x4000c000", "hex": "11000400", "op": "mem"}
{"gpa": "0x40010400", "hex": "", "op": "mem"}
{"gpa": "0x40010800", "hex": "", "op": "mem"}
{"gpa": "0x40010c00", "hex": "", "op": "mem"}
{"gpa": "0x40011000", "hex": "", "op": "mem"}
{"gpa": "0x40011400", "hex": "", "op": "mem"}
{"gpa": "0x40008000", "hex": "0100000001000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008010", "hex": "0300000001000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008020", "hex": "0100000002000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008030", "hex": "0100000003000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008040", "hex": "0100000004000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008050", "hex": "0100000005000000efbead7e00000000", "op": "mem"}
{"off": "0x1018", "op": "iosfc_w", "val": "0x6"}
{"iosfc_irqs": 6, "label": "iosfc irqs 6", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x40008000", "label": "map 16x8", "len": "0x10", "op": "dump"}
{"gpa": "0x40008010", "label": "test", "len": "0x10", "op": "dump"}
{"gpa": "0x40008020", "label": "map 512 MiB", "len": "0x10", "op": "dump"}
{"gpa": "0x40008030", "label": "map 512 MiB - 32 KiB", "len": "0x10", "op": "dump"}
{"gpa": "0x40008040", "label": "map to 1 GiB", "len": "0x10", "op": "dump"}
{"gpa": "0x40008050", "label": "map past 1 GiB", "len": "0x10", "op": "dump"}
{"gpa": "0x40008060", "hex": "0200000001000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008070", "hex": "0100000005000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008080", "hex": "0200000002000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008090", "hex": "0200000003000000efbead7e00000000", "op": "mem"}
{"gpa": "0x400080a0", "hex": "0200000004000000efbead7e00000000", "op": "mem"}
{"gpa": "0x400080b0", "hex": "0200000005000000efbead7e00000000", "op": "mem"}
{"off": "0x1018", "op": "iosfc_w", "val": "0xc"}
{"iosfc_irqs": 12, "label": "iosfc irqs 12", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x40008060", "label": "unmap 16x8", "len": "0x10", "op": "dump"}
{"gpa": "0x40008070", "label": "map again", "len": "0x10", "op": "dump"}
{"gpa": "0x40008080", "label": "unmap", "len": "0x10", "op": "dump"}
{"gpa": "0x40008090", "label": "unmap", "len": "0x10", "op": "dump"}
{"gpa": "0x400080a0", "label": "unmap", "len": "0x10", "op": "dump"}
{"gpa": "0x400080b0", "label": "unmap", "len": "0x10", "op": "dump"}
{"label": "guest memory", "op": "diff"}
{"label": "interrupts", "op": "events"}
