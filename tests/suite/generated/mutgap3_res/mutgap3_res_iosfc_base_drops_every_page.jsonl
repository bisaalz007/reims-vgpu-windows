# mutgap3_res_iosfc_base_drops_every_page: Writing the descriptor base drops every descriptor page's cached mapping, not only page 0's: mapping ID 17 (v2: 16 descriptors a page, so on descriptor page 1) from table T1, whose page 1 holds a valid descriptor, then unmapping it; then a new base, table T2, whose page 1 holds an invalid descriptor for ID 17: mapping 17 again reads T2's page (the entry's status is not 0) and leaves T1's page as it was.
{"iosfc": true, "op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1030", "op": "iosfc_w", "val": "0x1"}
{"off": "0x1010", "op": "iosfc_w", "val": "0x4000c000"}
{"off": "0x1000", "op": "iosfc_w", "val": "0x40008000"}
{"off": "0x1008", "op": "iosfc_w", "val": "0x400"}
{"gpa": "0x40010000", "hex": "15000400", "op": "mem"}
{"gpa": "0x4000c004", "hex": "19000400", "op": "mem"}
{"gpa": "0x40018400", "hex": "", "op": "mem"}
{"gpa": "0x40008000", "hex": "0100000011000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008010", "hex": "0200000011000000efbead7e00000000", "op": "mem"}
{"off": "0x1018", "op": "iosfc_w", "val": "0x2"}
{"iosfc_irqs": 2, "label": "iosfc irqs 2", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x40008000", "label": "T1: map 17, unmap 17", "len": "0x10", "op": "dump"}
{"gpa": "0x40008010", "label": "T1: map 17, unmap 17", "len": "0x10", "op": "dump"}
{"gpa": "0x4001c004", "hex": "21000400", "op": "mem"}
{"gpa": "0x40020400", "hex": "", "op": "mem"}
{"off": "0x1010", "op": "iosfc_w", "val": "0x4001c000"}
{"gpa": "0x40008020", "hex": "0100000011000000efbead7e00000000", "op": "mem"}
{"off": "0x1018", "op": "iosfc_w", "val": "0x3"}
{"iosfc_irqs": 3, "label": "iosfc irqs 3", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x40008020", "label": "T2: map 17", "len": "0x10", "op": "dump"}
{"gpa": "0x40018400", "label": "T1's descriptor 17, word 0", "len": "0x4", "op": "dump"}
{"gpa": "0x40020400", "label": "T2's descriptor 17, word 0", "len": "0x4", "op": "dump"}
{"label": "end", "op": "events"}
