# mutgap4_sys_iosfc_offset_v2: A surface's offset is kept for the test command, which writes its pattern from the surface's base address minus the offset: 16x8 BGRA surfaces (bytesPerRow 64) with offset 256 and an allocation of 1024, and with offset 512 and an allocation of 1024, v1 and v2, each mapped then tested; each status and data page is locked. Measured: both map, and the test's 1024-byte pattern starts at the data page's first byte.
{"iosfc": true, "op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1030", "op": "iosfc_w", "val": "0x1"}
{"off": "0x1010", "op": "iosfc_w", "val": "0x4000c000"}
{"off": "0x1000", "op": "iosfc_w", "val": "0x40008000"}
{"off": "0x1008", "op": "iosfc_w", "val": "0x400"}
{"gpa": "0x40010000", "hex": "15000400", "op": "mem"}
{"gpa": "0x4000c000", "hex": "19000400", "op": "mem"}
{"gpa": "0x40018400", "hex": "", "op": "mem"}
{"gpa": "0x4001c000", "hex": "21000400", "op": "mem"}
{"gpa": "0x40018800", "hex": "", "op": "mem"}
{"gpa": "0x40008000", "hex": "0100000001000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008010", "hex": "0300000001000000efbead7e00000000", "op": "mem"}
{"off": "0x1018", "op": "iosfc_w", "val": "0x2"}
{"iosfc_irqs": 2, "label": "iosfc irqs 2", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x40008000", "label": "offset 256, alloc 1024", "len": "0x10", "op": "dump"}
{"gpa": "0x40008010", "label": "offset 256, alloc 1024", "len": "0x10", "op": "dump"}
{"gpa": "0x40014000", "label": "offset 256, alloc 1024: data page", "len": "0x4000", "op": "diff"}
{"gpa": "0x40008020", "hex": "0100000002000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008030", "hex": "0300000002000000efbead7e00000000", "op": "mem"}
{"off": "0x1018", "op": "iosfc_w", "val": "0x4"}
{"iosfc_irqs": 4, "label": "iosfc irqs 4", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x40008020", "label": "offset 512, alloc 1024", "len": "0x10", "op": "dump"}
