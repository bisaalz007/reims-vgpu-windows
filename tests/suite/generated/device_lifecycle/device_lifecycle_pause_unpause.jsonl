# device_lifecycle_pause_unpause: While paused the root FIFO is drained: a NOP rung then is not run (its stamp wait times out), and the unpause restarts the FIFO, which runs it; unpause raises one interrupt of its own. Registers and guest memory across the pause.
{"op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_gpa": "0x40008000", "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x101c", "op": "mmio_w", "val": "0x10001"}
{"off": "0x1030", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1004", "op": "mmio_w", "val": "0x8000"}
{"off": "0x1010", "op": "mmio_w", "val": "0x400"}
{"off": "0x1000", "op": "mmio_w", "val": "0x1"}
{"gpa": "0x40008400", "hex": "1e0000000c00000001000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0xc"}
{"ge": "0x1", "gpa": "0x40008000", "label": "stamp 1 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"label": "running", "op": "events"}
{"name": "pause", "op": "api"}
{"label": "paused", "op": "events"}
{"from": "0x1000", "label": "paused", "op": "mmio_sweep", "step": 4, "to": "0x1300"}
{"gpa": "0x4000840c", "hex": "1e0000000c00000002000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0x18"}
{"ge": "0x2", "gpa": "0x40008000", "label": "a NOP while paused", "op": "wait", "timeout_ms": 500}
{"label": "a NOP rung while paused", "op": "events"}
{"off": "0x100c", "op": "mmio_r"}
{"name": "unpause", "op": "api"}
{"ge": "0x2", "gpa": "0x40008000", "label": "stamp 2 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"label": "unpaused: the NOP ran", "op": "events"}
{"from": "0x1000", "label": "unpaused", "op": "mmio_sweep", "step": 4, "to": "0x1300"}
