# device_lifecycle_reset: reset tears the root down, sets binary version 0 (so maxFIFOCount 32) and tears EFI down. Registers before and after; after it the guest negotiates again and runs. reset on a fresh device is harmless.
{"op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_gpa": "0x40008000", "stamp_slots": 2, "watchdog_s": 30}
{"name": "reset", "op": "api"}
{"from": "0x1000", "label": "reset fresh", "op": "mmio_sweep", "step": 4, "to": "0x1300"}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x101c", "op": "mmio_w", "val": "0x10001"}
{"off": "0x1030", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1004", "op": "mmio_w", "val": "0x8000"}
{"off": "0x1010", "op": "mmio_w", "val": "0x400"}
{"off": "0x1000", "op": "mmio_w", "val": "0x1"}
{"off": "0x1200", "op": "mmio_w", "val": "0x1"}
{"off": "0x1210", "op": "mmio_w", "val": "0x77"}
{"gpa": "0x40008400", "hex": "1e0000000c00000001000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0xc"}
{"ge": "0x1", "gpa": "0x40008000", "label": "stamp 1 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"label": "running", "op": "events"}
{"from": "0x1000", "label": "before reset", "op": "mmio_sweep", "step": 4, "to": "0x1300"}
{"name": "reset", "op": "api"}
{"label": "reset", "op": "events"}
{"from": "0x1000", "label": "after reset", "op": "mmio_sweep", "step": 4, "to": "0x1300"}
{"label": "after reset", "op": "diff"}
{"off": "0x101c", "op": "mmio_w", "val": "0x10001"}
{"off": "0x1000", "op": "mmio_w", "val": "0x1"}
{"gpa": "0x40008400", "hex": "1e0000000c00000002000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0xc"}
{"ge": "0x2", "gpa": "0x40008000", "label": "stamp 2 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"label": "a NOP at version 0", "op": "events"}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"gpa": "0x4000840c", "hex": "1e0000000c00000003000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0x18"}
{"ge": "0x3", "gpa": "0x40008000", "label": "stamp 3 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"label": "a NOP at 245", "op": "events"}
{"from": "0x1000", "label": "renegotiated", "op": "mmio_sweep", "step": 4, "to": "0x1300"}
{"label": "after", "op": "diff"}
