# covgap_mem_iosfc_straddle: The IOSurface host device over guest RAM whose second range is 0x6000 bytes: its second 16 KiB page is half outside it. A surface whose page table names that page cannot be mapped: the device's memory map finds the range holding the page's start and logs "Get straddles map ranges", and map writes NoMemory. A surface over the range's first page, and one over RAM, map. Map and isolate setups only, as iosfc.py: apple-gfx creates the IOSurface host device only with a memory map, and the device does not depend on the RvgDevice's setup.
{"iosfc": true, "op": "config", "ram": [["0x40000000", "0x4000000"], ["0x44040000", "0x6000"]], "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1030", "op": "iosfc_w", "val": "0x0"}
{"off": "0x1010", "op": "iosfc_w", "val": "0x4000c000"}
{"off": "0x1000", "op": "iosfc_w", "val": "0x40008000"}
{"off": "0x1008", "op": "iosfc_w", "val": "0x400"}
{"gpa": "0x40010000", "hex": "45400400", "op": "mem"}
{"gpa": "0x40014000", "hex": "41400400", "op": "mem"}
{"gpa": "0x40018000", "hex": "1d000400", "op": "mem"}
{"gpa": "0x4000c000", "hex": "21000400", "op": "mem"}
{"gpa": "0x40020200", "hex": "", "op": "mem"}
{"gpa": "0x40020400", "hex": "", "op": "mem"}
{"gpa": "0x40020600", "hex": "", "op": "mem"}
{"gpa": "0x40008000", "hex": "0100000001000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008010", "hex": "0100000002000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008020", "hex": "0100000003000000efbead7e00000000", "op": "mem"}
{"off": "0x1018", "op": "iosfc_w", "val": "0x3"}
{"iosfc_irqs": 3, "label": "iosfc irqs 3", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x40008000", "label": "the straddling page", "len": "0x10", "op": "dump"}
{"gpa": "0x40008010", "label": "the range's first page", "len": "0x10", "op": "dump"}
{"gpa": "0x40008020", "label": "a page in RAM", "len": "0x10", "op": "dump"}
{"label": "end", "op": "events"}
