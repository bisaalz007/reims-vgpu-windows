{"ge": "0x2", "gpa": "0x40008000", "irqs": 3, "op": "wait", "timeout_ms": 5000}
{"label": "0x1018 after the resume", "off": "0x1018", "op": "mmio_r"}
{"off": "0x1024", "op": "mmio_w", "val": "0x0"}
{"irq_stamps": true, "label": "resumed, then 0x1024 again", "op": "events"}
