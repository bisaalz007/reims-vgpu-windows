# fifo_stamp_fault_resume_registers: 0x102c reads 1 while any FIFO is faulted and is not cleared by reading; 0x1018 is read-to-clear; 0x1024 with nothing faulted changes nothing and raises no interrupt ("Stamp at head isn't faulted").
{"op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_gpa": "0x40008000", "stamp_slots": 1, "watchdog_s": 30}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x101c", "op": "mmio_w", "val": "0x10001"}
{"off": "0x1030", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1004", "op": "mmio_w", "val": "0x8000"}
{"off": "0x1010", "op": "mmio_w", "val": "0x400"}
{"off": "0x1000", "op": "mmio_w", "val": "0x1"}
{"off": "0x1024", "op": "mmio_w", "val": "0x0"}
{"gpa": "0x40008400", "hex": "1e0000000c00000001000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0xc"}
{"ge": "0x1", "gpa": "0x40008000", "label": "stamp 1 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"ge": "0x1", "gpa": "0x40008000", "irqs": 1, "op": "wait", "timeout_ms": 5000}
{"label": "0x1018", "off": "0x1018", "op": "mmio_r"}
{"label": "0x1018 again", "off": "0x1018", "op": "mmio_r"}
{"off": "0x1024", "op": "mmio_w", "val": "0x0"}
{"irq_stamps": true, "label": "0x1024 while healthy", "op": "events"}
{"label": "healthy", "off": "0x102c", "op": "mmio_r"}
{"label": "healthy", "off": "0x103c", "op": "mmio_r"}
{"gpa": "0x4000840c", "hex": "630000000c00000002000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0x18"}
{"label": "fault", "mmio": "0x102c", "mmio_eq": "0x1", "op": "wait", "timeout_ms": 5000}
{"label": "0x102c read 0", "off": "0x102c", "op": "mmio_r"}
{"label": "0x102c read 1", "off": "0x102c", "op": "mmio_r"}
{"label": "0x102c read 2", "off": "0x102c", "op": "mmio_r"}
