# device_mmio_fresh: A fresh device's registers: 0x122c reads 1 (count != 0 before any version) and every other offset in 0-0x4000 reads 0; 0x122c's aliases (0x4122c, unaligned 0x122d-0x122f, and a 64-bit offset that wraps) read 1 too, while offsets below 0x1000 wrap to unhandled indices and read 0.
{"op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_slots": 2, "watchdog_s": 30}
{"from": "0x0", "label": "fresh, 0-0x4000", "op": "mmio_sweep", "step": 4, "to": "0x4000"}
{"from": "0x40000", "label": "fresh, 0x40000-0x41400: aliases of 0x0-0x1400", "op": "mmio_sweep", "step": 4, "to": "0x41400"}
