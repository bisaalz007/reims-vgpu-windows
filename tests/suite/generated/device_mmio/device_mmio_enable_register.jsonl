# device_mmio_enable_register: 0x1000: a write equal to the enabled flag does nothing, 0 tears down, any nonzero value enables and reads back as 1; refused without a root page. Registers across disable and re-enable, and a NOP on each enabled FIFO (the ring restarts at the start offset).
{"op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x1000", "op": "mmio_w", "val": "0x0"}
{"label": "0 while disabled", "off": "0x1000", "op": "mmio_r"}
{"off": "0x1030", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1004", "op": "mmio_w", "val": "0x8000"}
{"off": "0x1010", "op": "mmio_w", "val": "0x400"}
{"off": "0x1000", "op": "mmio_w", "val": "0x2"}
{"label": "2 without a root page: refused", "off": "0x1000", "op": "mmio_r"}
{"off": "0x101c", "op": "mmio_w", "val": "0x10001"}
{"off": "0x1000", "op": "mmio_w", "val": "0x2"}
{"label": "2 with a root page: enabled", "off": "0x1000", "op": "mmio_r"}
{"off": "0x1000", "op": "mmio_w", "val": "0x1"}
{"label": "1 while enabled: nothing", "off": "0x1000", "op": "mmio_r"}
{"gpa": "0x40008400", "hex": "1e0000000c00000001000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0xc"}
{"ge": "0x1", "gpa": "0x40008000", "label": "stamp 1 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"label": "a NOP", "op": "events"}
{"from": "0x1000", "label": "enabled", "op": "mmio_sweep", "step": 4, "to": "0x1040"}
{"off": "0x1000", "op": "mmio_w", "val": "0x0"}
{"from": "0x1000", "label": "disabled", "op": "mmio_sweep", "step": 4, "to": "0x1040"}
{"off": "0x1000", "op": "mmio_w", "val": "0x0"}
{"label": "0 again", "off": "0x1000", "op": "mmio_r"}
{"off": "0x1000", "op": "mmio_w", "val": "0xffffffff"}
{"label": "0xffffffff: enabled", "off": "0x1000", "op": "mmio_r"}
{"gpa": "0x40008400", "hex": "1e0000000c00000002000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0xc"}
{"ge": "0x2", "gpa": "0x40008000", "label": "stamp 2 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"label": "a NOP on the re-enabled FIFO", "op": "events"}
{"from": "0x1000", "label": "re-enabled", "op": "mmio_sweep", "step": 4, "to": "0x1040"}
{"label": "after", "op": "diff"}
