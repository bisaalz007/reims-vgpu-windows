# device_root_page_unmappable: A root page the device cannot map (past guest RAM, or 0xffffffff) is still what 0x101c reads, but there is no root node: the root FIFO is refused. In the blocks setup the root task is created, its mapping fails, and it is destroyed at once. A later good page works.
{"op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x101c", "op": "mmio_w", "val": "0x11000"}
{"off": "0x101c", "op": "mmio_r"}
{"off": "0x1030", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1004", "op": "mmio_w", "val": "0x8000"}
{"off": "0x1010", "op": "mmio_w", "val": "0x400"}
{"off": "0x1000", "op": "mmio_w", "val": "0x1"}
{"label": "enable on an unmapped root", "off": "0x1000", "op": "mmio_r"}
{"label": "an unmappable root page", "op": "events"}
{"off": "0x101c", "op": "mmio_w", "val": "0xffffffff"}
{"off": "0x101c", "op": "mmio_r"}
{"off": "0x1030", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1004", "op": "mmio_w", "val": "0x8000"}
{"off": "0x1010", "op": "mmio_w", "val": "0x400"}
{"off": "0x1000", "op": "mmio_w", "val": "0x1"}
{"label": "enable on an unmapped root", "off": "0x1000", "op": "mmio_r"}
{"label": "an unmappable root page", "op": "events"}
{"off": "0x101c", "op": "mmio_w", "val": "0x10001"}
{"off": "0x1000", "op": "mmio_w", "val": "0x1"}
{"gpa": "0x40008400", "hex": "1e0000000c00000001000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0xc"}
{"ge": "0x1", "gpa": "0x40008000", "label": "stamp 1 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"label": "a good page", "op": "events"}
{"from": "0x1000", "label": "a good page", "op": "mmio_sweep", "step": 4, "to": "0x1040"}
