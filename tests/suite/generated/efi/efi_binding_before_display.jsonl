# efi_binding_before_display: EFI binds the display parked at port 0 when EFI is created, and only then: created before any display it binds none; a display with a shared page is not parked (its guest display holds it), so EFI binds none either; releasing the bound display unbinds it, and a display on port 1 is never bound. Trace blocks make every present deterministic.
{"descriptor": {"trace": true}, "op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x1200", "op": "mmio_w", "val": "0x1"}
{"name": "new_display", "op": "api", "spec": {"modes": [[64, 32, 60]], "name": "suite", "port": 0, "serial": 1000}}
{"off": "0x121c", "op": "mmio_w", "val": "0x80010"}
{"off": "0x1218", "op": "mmio_w", "val": "0x20"}
{"off": "0x1228", "op": "mmio_w", "val": "0x40"}
{"off": "0x1210", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1214", "op": "mmio_w", "val": "0x4000"}
{"op": "quiesce", "quiet_ms": 100}
{"label": "no present", "op": "events"}
{"off": "0x1200", "op": "mmio_w", "val": "0x0"}
{"off": "0x1200", "op": "mmio_w", "val": "0x1"}
{"off": "0x121c", "op": "mmio_w", "val": "0x80010"}
{"off": "0x1218", "op": "mmio_w", "val": "0x20"}
{"off": "0x1228", "op": "mmio_w", "val": "0x40"}
{"off": "0x1210", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1214", "op": "mmio_w", "val": "0x4000"}
{"cb": "newFrame", "cb_count": 1, "label": "re-created: bound", "op": "wait", "timeout_ms": 5000}
{"label": "bound after re-creation", "op": "events"}
