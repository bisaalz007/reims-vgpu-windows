# efi_timer_no_display: EFI with no display bound, on the timer: the first tick finds no display and stops presenting (cancels its own timer). A display attached afterwards is not bound, because EFI binds only at creation: nothing is ever presented.
{"op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x1200", "op": "mmio_w", "val": "0x1"}
{"off": "0x121c", "op": "mmio_w", "val": "0x80010"}
{"off": "0x1218", "op": "mmio_w", "val": "0x20"}
{"off": "0x1228", "op": "mmio_w", "val": "0x40"}
{"off": "0x1210", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1214", "op": "mmio_w", "val": "0x4000"}
{"name": "new_display", "op": "api", "spec": {"modes": [[64, 32, 60]], "name": "suite", "port": 0, "serial": 1000}}
{"op": "quiesce", "quiet_ms": 300}
{"label": "no present", "op": "events"}
{"display": 0, "name": "present_counts", "op": "api"}
{"display": 0, "h": 8, "label": "no frame", "op": "encode", "w": 16}
