# efi_trace_remove_only: A config with add_trace_range and no remove_trace_range is refused     at device creation (RVG_ERR_INVALID_ARGUMENT); one with only     remove_trace_range is accepted, and EFI     then falls back to the timer (here with no display, so the first tick stops it).
{"descriptor": {"trace": {"remove": true}}, "op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x1200", "op": "mmio_w", "val": "0x1"}
{"off": "0x121c", "op": "mmio_w", "val": "0x80010"}
{"off": "0x1218", "op": "mmio_w", "val": "0x20"}
{"off": "0x1228", "op": "mmio_w", "val": "0x40"}
{"off": "0x1210", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1214", "op": "mmio_w", "val": "0x4000"}
{"op": "quiesce", "quiet_ms": 300}
{"label": "timer, no display", "op": "events"}
{"off": "0x1200", "op": "mmio_w", "val": "0x0"}
