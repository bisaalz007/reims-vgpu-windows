# device_create_no_raise_interrupt: Without a raise_interrupt callback the device is created and runs, and the first interrupt ends the process. The first interrupt here is -unpause's, which it raises on the calling thread, so the op it dies at is certain; a stamp's would be raised on the FIFO's thread, racing the runner's ops.
{"descriptor": {"no_raise": true}, "op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_gpa": "0x40008000", "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x101c", "op": "mmio_w", "val": "0x10001"}
{"off": "0x1030", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1004", "op": "mmio_w", "val": "0x8000"}
{"off": "0x1010", "op": "mmio_w", "val": "0x400"}
{"off": "0x1000", "op": "mmio_w", "val": "0x1"}
{"from": "0x1000", "label": "running without raiseInterrupt", "op": "mmio_sweep", "step": 4, "to": "0x1300"}
{"name": "pause", "op": "api"}
{"name": "unpause", "op": "api"}
