# device_create_iosurface_mapper: The config QEMU's apple-gfx-mmio gives: use_iosurface_mapper set and argument buffers on, with an IOSurface host device created first, and after. The device runs and its device info is the setup's. Map and isolate setups only: the IOSurface host device needs a memory map.
{"iosfc": true, "op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_gpa": "0x40008000", "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x101c", "op": "mmio_w", "val": "0x10001"}
{"off": "0x1030", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1004", "op": "mmio_w", "val": "0x8000"}
{"off": "0x1010", "op": "mmio_w", "val": "0x400"}
{"off": "0x1000", "op": "mmio_w", "val": "0x1"}
{"gpa": "0x40008400", "hex": "1e0000000c00000001000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0xc"}
{"ge": "0x1", "gpa": "0x40008000", "label": "stamp 1 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"label": "a NOP", "op": "events"}
{"from": "0x1000", "label": "running", "op": "mmio_sweep", "step": 4, "to": "0x1300"}
{"gpa": "0x4000840c", "hex": "3a0000001800000002000000400000004000000004000100", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0x24"}
{"ge": "0x2", "gpa": "0x40008000", "label": "stamp 2 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x40010000", "label": "device info", "len": "0x180", "op": "dump"}
