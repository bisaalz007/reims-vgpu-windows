# fresh_resume_paused: A device paused when the host suspends (pause, then rvg_device_will_suspend and rvg_device_finish_suspend), with no display page: a NOP rung while paused does not run (pause stops the FIFOs), so the blob's read count (key 7) is before it and its written count (key 6) after. The pause is not in the blob: the target runs unpaused, runs the NOP at once, and unpause there, with no guest display, is harmless.
{"op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_gpa": "0x40008000", "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x101c", "op": "mmio_w", "val": "0x10001"}
{"off": "0x1030", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1004", "op": "mmio_w", "val": "0x8000"}
{"off": "0x1010", "op": "mmio_w", "val": "0x400"}
{"off": "0x1000", "op": "mmio_w", "val": "0x1"}
{"gpa": "0x40008400", "hex": "1e0000000c00000001000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0xc"}
{"ge": "0x1", "gpa": "0x40008000", "label": "stamp 1 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"name": "pause", "op": "api"}
{"gpa": "0x4000840c", "hex": "1e0000000c00000002000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0x18"}
{"ge": "0x2", "gpa": "0x40008000", "label": "a NOP while paused", "op": "wait", "timeout_ms": 500}
{"op": "quiesce", "quiet_ms": 100}
{"label": "paused", "op": "events"}
{"name": "willSuspend", "op": "api"}
{"name": "finishSuspend", "op": "api", "slot": "s"}
{"image": "0", "op": "handoff_save"}
{"op": "phase"}
{"handoff_load": {"image": "0"}, "op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_gpa": "0x40008000", "stamp_slots": 2, "watchdog_s": 30}
{"name": "willResume", "op": "api", "slot": "s"}
{"name": "didResume", "op": "api"}
{"irqs": 1, "op": "wait", "timeout_ms": 5000}
{"op": "quiesce", "quiet_ms": 100}
{"label": "resumed", "op": "events"}
{"from": "0x1000", "label": "registers", "op": "mmio_sweep", "step": 4, "to": "0x1040"}
{"ge": "0x2", "gpa": "0x40008000", "label": "the NOP rung while paused", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x40008418", "hex": "1e0000000c00000003000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0x24"}
{"ge": "0x3", "gpa": "0x40008000", "label": "stamp 3 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"label": "on the target, never paused", "name": "unpause", "op": "api"}
{"op": "quiesce", "quiet_ms": 100}
{"label": "end", "op": "events"}
