# fresh_dev_suspend_did_on_fresh_device: rvg_device_did_resume on a device that was never versioned or given a root page: root page 0 builds nothing, and it raises its one interrupt. The guest then brings the device up as usual.
{"displays": [{"modes": [[64, 32, 60]], "name": "suite", "port": 0, "serial": 1000}], "op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_gpa": "0x40008000", "stamp_slots": 2, "watchdog_s": 30}
{"name": "didResume", "op": "api"}
{"label": "after didResume", "op": "events"}
{"from": "0x1000", "label": "registers", "op": "mmio_sweep", "step": 4, "to": "0x1040"}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x101c", "op": "mmio_w", "val": "0x10001"}
{"off": "0x1030", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1004", "op": "mmio_w", "val": "0x8000"}
{"off": "0x1010", "op": "mmio_w", "val": "0x400"}
{"off": "0x1000", "op": "mmio_w", "val": "0x1"}
{"gpa": "0x40008400", "hex": "1e0000000c00000001000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0xc"}
{"ge": "0x1", "gpa": "0x40008000", "label": "stamp 1 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"label": "end", "op": "events"}
