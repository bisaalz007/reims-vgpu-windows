# fifo_child_resume_64: 0x1028 = 64 is past the 64 child slots: the mask shift 1ULL << 64 wraps to bit 0, the root's, and no FIFO is resumed. With the root faulted, it clears the root's bit, so 0x102c reads 0; the root is still stuck until 0x1024.
{"op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_gpa": "0x40008000", "stamp_slots": 1, "watchdog_s": 30}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x101c", "op": "mmio_w", "val": "0x10001"}
{"off": "0x1030", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1004", "op": "mmio_w", "val": "0x8000"}
{"off": "0x1010", "op": "mmio_w", "val": "0x400"}
{"off": "0x1000", "op": "mmio_w", "val": "0x1"}
{"off": "0x1028", "op": "mmio_w", "val": "0x40"}
{"label": "0x1028 = 64 while healthy", "off": "0x102c", "op": "mmio_r"}
{"label": "0x1028 = 64 while healthy", "off": "0x103c", "op": "mmio_r"}
{"gpa": "0x40008400", "hex": "630000000c00000001000000", "op": "mem"}
{"off": "0x1008", "op": "mmio_w", "val": "0xc"}
{"label": "fault", "mmio": "0x102c", "mmio_eq": "0x1", "op": "wait", "timeout_ms": 5000}
{"off": "0x1028", "op": "mmio_w", "val": "0x40"}
{"label": "0x1028 = 64 while the root is faulted", "off": "0x102c", "op": "mmio_r"}
{"label": "0x1028 = 64 while the root is faulted", "off": "0x103c", "op": "mmio_r"}
{"ge": "0x1", "gpa": "0x40008000", "label": "the root is still stuck", "op": "wait", "timeout_ms": 500}
{"off": "0x1024", "op": "mmio_w", "val": "0x0"}
{"ge": "0x1", "gpa": "0x40008000", "label": "stamp 1 on FIFO 0", "op": "wait", "timeout_ms": 5000}
{"label": "0x1024", "off": "0x102c", "op": "mmio_r"}
{"label": "0x1024", "off": "0x103c", "op": "mmio_r"}
{"irq_stamps": true, "label": "resume 64", "op": "events"}
