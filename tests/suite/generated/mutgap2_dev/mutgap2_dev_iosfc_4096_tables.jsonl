# mutgap2_dev_iosfc_4096_tables: A v2 surface of 4096 x 4095 + 1 pages needs exactly 4096 page-table pages, which the device allows: the map goes on to walk the root table, whose entry 0 is invalid, so the status is BadArgument ("root table invalid"), not NoMemory. So is a surface of exactly 4096 x 4096 pages, the most the page-count check allows; 4096 x 4096 + 1 pages is NoMemory. Map and isolate only.
{"iosfc": true, "op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1030", "op": "iosfc_w", "val": "0x1"}
{"off": "0x1010", "op": "iosfc_w", "val": "0x4000c000"}
{"off": "0x1000", "op": "iosfc_w", "val": "0x40008000"}
{"off": "0x1008", "op": "iosfc_w", "val": "0x400"}
{"gpa": "0x40010000", "hex": "02000000", "op": "mem"}
{"gpa": "0x4000c000", "hex": "15000400", "op": "mem"}
{"gpa": "0x40014400", "hex": "", "op": "mem"}
{"gpa": "0x40014800", "hex": "", "op": "mem"}
{"gpa": "0x40014c00", "hex": "", "op": "mem"}
{"gpa": "0x40008000", "hex": "0100000001000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008010", "hex": "0100000002000000efbead7e00000000", "op": "mem"}
{"gpa": "0x40008020", "hex": "0100000003000000efbead7e00000000", "op": "mem"}
{"off": "0x1018", "op": "iosfc_w", "val": "0x3"}
{"iosfc_irqs": 3, "label": "iosfc irqs 3", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x40008000", "label": "4096 x 4095 + 1 pages", "len": "0x10", "op": "dump"}
{"gpa": "0x40008010", "label": "4096 x 4096 + 1 pages", "len": "0x10", "op": "dump"}
{"gpa": "0x40008020", "label": "4096 x 4096 pages", "len": "0x10", "op": "dump"}
{"label": "end", "op": "events"}
