# mutgap2_dev_iosfc_ring_size_0: A ring size of 0 written while a ring is mapped is ignored: 0x1008 still reads the old size and the next command runs from the same ring. Map and isolate only: the IOSurface host device needs a memory map.
{"iosfc": true, "op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1030", "op": "iosfc_w", "val": "0x0"}
{"off": "0x1010", "op": "iosfc_w", "val": "0x4000c000"}
{"off": "0x1000", "op": "iosfc_w", "val": "0x40008000"}
{"off": "0x1008", "op": "iosfc_w", "val": "0x400"}
{"gpa": "0x40010000", "hex": "15000400", "op": "mem"}
{"gpa": "0x4000c000", "hex": "19000400", "op": "mem"}
{"gpa": "0x40018200", "hex": "", "op": "mem"}
{"gpa": "0x40008000", "hex": "0100000001000000efbead7e00000000", "op": "mem"}
{"off": "0x1018", "op": "iosfc_w", "val": "0x1"}
{"iosfc_irqs": 1, "label": "iosfc irqs 1", "op": "wait", "timeout_ms": 5000}
{"gpa": "0x40008000", "label": "map", "len": "0x10", "op": "dump"}
{"off": "0x1008", "op": "iosfc_w", "val": "0x0"}
