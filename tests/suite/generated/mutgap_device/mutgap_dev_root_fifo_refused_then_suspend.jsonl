# mutgap_dev_root_fifo_refused_then_suspend: A root FIFO whose start is not below its length is refused after its mapping was made: the root FIFO's creation releases the mapping and clears its pointer, so rvg_device_finish_suspend's release of it releases nil. 0x1000 reads 0; in the blocks setup the mapping's task calls are locked; the blob says the FIFO is off.
{"op": "config", "ram": [["0x40000000", "0x4000000"]], "stamp_slots": 2, "watchdog_s": 30}
{"off": "0x1034", "op": "mmio_w", "val": "0xf5"}
{"off": "0x101c", "op": "mmio_w", "val": "0x10001"}
{"off": "0x1030", "op": "mmio_w", "val": "0x10002"}
{"off": "0x1004", "op": "mmio_w", "val": "0x8000"}
{"off": "0x1010", "op": "mmio_w", "val": "0x8000"}
{"off": "0x1000", "op": "mmio_w", "val": "0x1"}
{"label": "start 0x8000, length 0x8000", "off": "0x1000", "op": "mmio_r"}
{"label": "refused", "op": "events"}
{"name": "willSuspend", "op": "api"}
{"name": "finishSuspend", "op": "api", "slot": "s"}
{"label": "suspended", "op": "events"}
{"from": "0x1000", "label": "registers after finishSuspend", "op": "mmio_sweep", "step": 4, "to": "0x1040"}
